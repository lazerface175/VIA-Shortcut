{
  "manifest_version": 3,
  "name": "VIA Keycode Finder",
  "version": "1.0.0",
  "description": "Press a key combination, get the QMK string for usevia.app's Special → Any field.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "VIA Keycode Finder",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      }
    }
  }
}
